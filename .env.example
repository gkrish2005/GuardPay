# Server
PORT=3000

# Database (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Razorpay (test-mode keys only — never commit real values)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Mock LLM Toggle (Default: "true" for quota-free, fast automated test runs. Set to "false" only for live conversational demo recording against the real Gemini API)
MOCK_LLM="true"

# Optional: ngrok authtoken for stable tunnel URLs (https://dashboard.ngrok.com)
NGROK_AUTHTOKEN=
